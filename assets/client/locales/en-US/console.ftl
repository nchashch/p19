console-controls =
    { "[" }WASD] move
    { "[" }RMB] rotate camera
    { "[" }LMB] select
    { "[" }ESC] deselect
    { "[" }E] spawn cube
    { "[" }R] spawn NPC
    { "[" }T] kill selected
    { "[" }F] attack selected
    { "[" }Esc] menu
    { "[" }Tab] stats
console-respawned = respawned
console-cubes-despawned = cubes despawned
console-npcs-despawned = npcs despawned
console-load-level-missing-id = please provide level asset id, available levels:
    { $levels }
console-load-level-loading = loading level "{ $id }"
console-load-level-not-found = no such level, available levels:
    { $levels }
console-nothing-selected = nothing selected
console-available-clips = available clips:
    { $clips }
console-clip-not-found = clip { $clip } doesn't exist, available clips:
    { $clips }
console-playing-clip = playing clip "{ $clip }"
console-fps-toggled = fps overlay toggled
console-physics-debug-toggled = physics debug gizmos toggled
console-nameplates-toggled = nameplates toggled
console-hud-toggled = HUD toggled
