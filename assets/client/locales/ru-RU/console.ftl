console-controls =
    { "[" }WASD] движение
    { "[" }ПКМ] вращение камеры
    { "[" }ЛКМ] выбор
    { "[" }ESC] снять выбор
    { "[" }E] заспавнить куб
    { "[" }R] заспавнить NPC
    { "[" }T] убить выбранного
    { "[" }F] атаковать выбранного
    { "[" }Esc] меню
    { "[" }Tab] статистика
console-respawned = возрождён
console-cubes-despawned = кубы удалены
console-npcs-despawned = NPC удалены
console-load-level-missing-id = укажите id уровня, доступные уровни:
    { $levels }
console-load-level-loading = загрузка уровня "{ $id }"
console-load-level-not-found = такого уровня нет, доступные уровни:
    { $levels }
console-nothing-selected = ничего не выбрано
console-available-clips = доступные анимации:
    { $clips }
console-clip-not-found = анимация { $clip } не найдена, доступные анимации:
    { $clips }
console-playing-clip = проигрывается анимация "{ $clip }"
console-fps-toggled = счётчик FPS переключён
console-physics-debug-toggled = отладка физики переключена
console-nameplates-toggled = таблички с именами переключены
console-hud-toggled = HUD переключён
